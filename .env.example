# Data directory for SQLite database persistence
DATA_PATH=./data

# Auth service configuration
AUTH_SERVICE_URL=http://localhost:20263
AUTH_SERVICE_JWKS_URL=http://localhost:20263/.well-known/jwks.json
AUTH_CLIENT_ID=navigation
AUTH_CLIENT_SECRET=local-navigation-secret

# Frontend URL (used in OAuth callback)
FRONTEND_URL=http://localhost:20261

# CORS allowed origins (comma-separated, must match FRONTEND_URL)
CORS_ORIGINS=http://localhost:20261

# Email (SMTP) configuration for password reset (legacy, now handled by auth-service)
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=your-email@163.com
SMTP_PASSWORD=your-smtp-password

# Host port for the frontend (default: 20261)
PORT=20261
